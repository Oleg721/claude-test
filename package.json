{
  "name": "claude-test",
  "version": "1.0.0",
  "description": "API playground: one LLM port, several adapters picked per request, feature routes on top",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "build": "tsc",
    "start": "node dist/main.js",
    "bench": "node bench/run.mjs",
    "bench:summary": "node bench/summarize.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.115.0",
    "@hono/node-server": "^2.0.12",
    "hono": "^4.12.32",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
